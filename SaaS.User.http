### 2. Kullanıcının Rolünü Değiştir (Change Role)
# Şirkete ait bir kullanıcının rolünü günceller.
# Not: Sadece Admin veya SuperAdmin rolüne sahip kullanıcılar bu isteği yapabilir.
PUT {{baseUrl}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userPublicId": "123e4567-e89b-12d3-a456-426614174000",
  "roleId": 2 
}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "Kullanıcı rolü başarıyla değiştirildi"
# }

# Olası Hata Senaryosu - Rol ID Bulunamadı (404 Not Found):
# {
#   "isSuccess": false,
#   "message": "Rol bulunamadı"
# }

# Olası Hata Senaryosu - Yetkisiz İşlem / Başka Şirketin Kullanıcısı (403 Forbidden):
# {
#   "isSuccess": false,
#   "message": "Bu işlemi yapamazsınız"
# }