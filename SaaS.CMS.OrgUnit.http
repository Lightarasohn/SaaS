@baseUrl = http://localhost:5012/api/OrgUnit
# Tüm işlemler için 'cost-management' yetkisine sahip token gereklidir.
# Atama (Assign) işlemleri için bu token sahibinin SuperAdmin VEYA ilgili birimin (veya üst biriminin) Manager'ı olması gerekir.
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..iRhfHEKQmbw8hqFLwW3MxR7whDgjRoeyNWL5D_uQksM
# Şirkete ait tüm birimleri hiyerarşik sırayla listeler.
# Level bilgisi ağaç yapısını göstermek, memberCount ise birimdeki
# aktif kullanıcı sayısını göstermek içindir.
GET {{baseUrl}}
Authorization: Bearer {{accessToken}}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "İşlem başarılı",
#   "data": [
#     {
#       "publicId": "123e4567-e89b-12d3-a456-426614174000",
#       "name": "Genel Müdürlük",
#       "level": 0,
#       "isActive": true,
#       "memberCount": 3
#     },
#     {
#       "publicId": "333e4567-e89b-12d3-a456-426614174003",
#       "name": "Yazılım Departmanı",
#       "level": 1,
#       "isActive": true,
#       "memberCount": 0
#     }
#   ]
# }


### 2. Yeni Organizasyon Birimi Oluştur (Create)
# Sisteme yeni bir birim ekler. Üst birimi (Parent) yoksa parentPublicId için
# "00000000-0000-0000-0000-000000000000" gönderilebilir veya alan hiç gönderilmez.
POST {{baseUrl}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "parentPublicId": null,
  "name": "DenemeSilme"
}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "Birim oluşturuldu",
#   "data": {
#     "publicId": "444e4567-e89b-12d3-a456-426614174004",
#     "name": "Pazarlama",
#     "level": 2,
#     "isActive": true,
#     "memberCount": 0
#   }
# }


### 3. Birime Kullanıcı Ata (Assign User)
# Belirli bir kullanıcıyı ilgili organizasyon birimine 'User' rolü ile atar.
# Not: Yalnızca SuperAdmin veya (üst) Manager atama yapabilir. Çapraz firma ataması yapılamaz.
POST {{baseUrl}}/assign/user
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userPublicId": "262b0f10-c399-4afb-8bb5-504dfa0f6c1b",
  "orgUnitPublicId": "08da461f-ba84-4ae5-9ce3-3aa2475bebbc"
}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "Kullanıcı başarıyla birime User olarak atandı"
# }

# Olası Hata Senaryosu - Yetkisiz İşlem (403 Forbidden):
# {
#   "isSuccess": false,
#   "message": "Bu işlemi yapamazsınız"
# }


### 4. Birime Onaylayıcı Ata (Assign Approver)
# Belirli bir kullanıcıyı ilgili organizasyon birimine bütçe/masraf onaylayıcısı ('Approver') rolü ile atar.
POST {{baseUrl}}/assign/approver
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userPublicId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "orgUnitPublicId": "444e4567-e89b-12d3-a456-426614174004"
}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "Kullanıcı başarıyla birime Approver olarak atandı"
# }


### 5. Birime Yönetici Ata (Assign Manager)
# Belirli bir kullanıcıyı ilgili organizasyon birimine yönetici ('Manager') rolü ile atar.
# Özel İş Kuralı: Bir Manager kendi bulunduğu birime başka birini Manager olarak atayamaz (Alt birimlere atayabilir).
POST {{baseUrl}}/assign/manager
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userPublicId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "orgUnitPublicId": "444e4567-e89b-12d3-a456-426614174004"
}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "Kullanıcı başarıyla birime Manager olarak atandı"
# }

# Olası Hata Senaryosu - Kendi Birimine Manager Atama Denemesi (403 Forbidden):
# {
#   "isSuccess": false,
#   "message": "Bu işlemi yapamazsınız"
# }


### 6. Tek Birimi Getir (Get By Id)
GET {{baseUrl}}/46ee27c2-3786-43a3-9e9d-29183646de71
Authorization: Bearer {{accessToken}}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "İşlem başarılı",
#   "data": {
#     "publicId": "123e4567-e89b-12d3-a456-426614174000",
#     "name": "Genel Müdürlük",
#     "level": 0,
#     "isActive": true,
#     "memberCount": 3
#   }
# }


### 7. Birimdeki Üyeleri Getir (Get Members)
# Birime atanmış aktif kullanıcıları, birimdeki rolleriyle birlikte listeler.
# Kullanıcı adı ve e-posta Master DB'den ayrı sorguyla çekilip eşleştirilir.
GET {{baseUrl}}/46ee27c2-3786-43a3-9e9d-29183646de71/members
Authorization: Bearer {{accessToken}}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "İşlem başarılı",
#   "data": [
#     {
#       "userPublicId": "6d672f0a-2be1-4f7d-9b46-9b3d13dfd891",
#       "userName": "Onur Owner",
#       "email": "onur.demir.dev@outlook.com",
#       "roleName": "Manager",
#       "assignedAt": "2026-09-14T13:09:17.4569953Z"
#     }
#   ]
# }

# Olası Hata Senaryosu - Birim Bulunamadı (404 Not Found):
# {
#   "isSuccess": false,
#   "message": "Birim bulunamadı"
# }


### 8. Birimi Güncelle (Update)
# Birimin adını değiştirir. Hiyerarşideki yeri (parent) değiştirilemez —
# bir birimi başka bir ebeveynin altına taşımak tüm alt ağacın path
# değerlerinin yeniden hesaplanmasını gerektirir, kapsam dışıdır.
# Not: SuperAdmin VEYA o birimin Manager'ı yapabilir.
PUT {{baseUrl}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "orgUnitPublicId": "46ee27c2-3786-43a3-9e9d-29183646de71",
  "name": "Pazarlama ve İletişim"
}

# Beklenen Cevap (200 OK):
# {
#   "isSuccess": true,
#   "message": "Birim güncellendi",
#   "data": {
#     "publicId": "46ee27c2-3786-43a3-9e9d-29183646de71",
#     "name": "Pazarlama ve İletişim",
#     "level": 1,
#     "isActive": true,
#     "memberCount": 2
#   }
# }

# Olası Hata Senaryosu - Yetkisiz İşlem (403 Forbidden):
# {
#   "isSuccess": false,
#   "message": "Bu işlemi yapamazsınız"
# }

# Olası Hata Senaryosu - Boş Ad (400 Bad Request):
# {
#   "isSuccess": false,
#   "message": "Birim adı boş olamaz"
# }


### 9. Birim Durumunu Değiştir (Toggle Active)
# Aktif birimi pasifleştirir veya pasif birimi aktifleştirir.
#
# İki iş kuralı:
#  - Pasifleştirme alt ağacı da kapsar. Aktif bir birim, pasif bir
#    birimin altında duramaz.
#  - Aktifleştirme üst birimin aktif olmasını gerektirir.
#
# Not: Yalnızca SuperAdmin yapabilir.
POST {{baseUrl}}/toggle-active
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "orgUnitPublicId": "46ee27c2-3786-43a3-9e9d-29183646de71"
}

# Beklenen Cevap - Pasifleştirme, alt birimi olmayan (200 OK):
# {
#   "isSuccess": true,
#   "message": "Birim pasifleştirildi",
#   "data": {
#     "publicId": "46ee27c2-3786-43a3-9e9d-29183646de71",
#     "name": "Pazarlama",
#     "level": 1,
#     "isActive": false,
#     "memberCount": 0
#   }
# }

# Beklenen Cevap - Pasifleştirme, alt birimleriyle (200 OK):
# {
#   "isSuccess": true,
#   "message": "Birim ve 3 alt birimi pasifleştirildi",
#   "data": { ... }
# }

# Beklenen Cevap - Aktifleştirme (200 OK):
# {
#   "isSuccess": true,
#   "message": "Birim aktifleştirildi",
#   "data": { ... }
# }

# Olası Hata Senaryosu - Üst Birim Pasif (409 Conflict):
# {
#   "isSuccess": false,
#   "message": "Önce üst birim (Genel Müdürlük) aktifleştirilmeli"
# }

# Olası Hata Senaryosu - Yetkisiz İşlem (403 Forbidden):
# {
#   "isSuccess": false,
#   "message": "Yalnızca organizasyon sahibi birim durumunu değiştirebilir"
# }

### 10. Birimi Sil (Delete)
# Kalıcı siler. Yanlış oluşturulmuş birimleri temizlemek içindir.
#
# Engeller:
#  - Alt birimi varsa silinmez
#  - Bütçe kaydı varsa silinmez (pasifleştirme önerilir)
#
# Üye atamaları birimle birlikte silinir.
# Not: Yalnızca SuperAdmin yapabilir.
DELETE {{baseUrl}}/23fc625c-e299-47a5-93cc-07f986b24f18
Authorization: Bearer {{accessToken}}

# Beklenen Cevap (200 OK):
# { "isSuccess": true, "message": "Birim silindi" }

# Olası Hata - Alt Birim Var (409 Conflict):
# { "isSuccess": false, "message": "Bu birimin alt birimleri var. Önce onları silin." }

# Olası Hata - Bütçe Var (409 Conflict):
# { "isSuccess": false, "message": "Bu birime ait bütçe kayıtları var. Silmek yerine pasifleştirebilirsiniz." }
